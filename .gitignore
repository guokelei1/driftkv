# Python environments, builds and caches
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
.coverage*
htmlcov/

# Local datasets, expanded manifests and model payloads
/data/
/checkpoints/
/configs/generated/
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.pkl
*.msgpack
*.parquet
*.npy
*.npz
*.h5
