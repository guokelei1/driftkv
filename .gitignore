*.feather

# Results are local by default. Keep compact evidence, not raw payloads,
# progress/runtime logs or recovery archives. Never use `git add -f` for a
# dataset or checkpoint; add an explicit exception for a needed small record.
/results/**
!/results/**/
!/results/**/*.md
!/results/**/summary.json
!/results/**/adjudication.json
!/results/**/*.seal.json
!/results/**/train_result.json
!/results/**/resource_estimate.json
!/results/**/canary.pass.json
!/results/**/configuration.json
!/results/**/admission/*.json
!/results/**/analysis/*.csv
!/results/**/analysis_v2/*.csv
!/results/design/**/launch_record.json
!/results/design/**/loaded_reference_check.json
!/results/design/**/compiled_v*.pass.json
!/results/design/**/compiled_service_v*.json
!/results/design/**/response_canary.pass.json
!/results/design/**/response_comparison.json
!/results/design/analysis/*_probe.json
!/results/design/analysis/*_quality.json
!/results/design/analysis/*_launch_record.json
!/results/release_cost_random_weight_v1/*_gpu_only.json
!/results/yambda500m_large_seed17/canonical_D14_v0_v5_v1/*.json
!/results/yambda500m_small_seed17/insight_pro_lazy_reader_v1/correctness_cost_v2/theoretical_compute.json

# Figure source, small CSV/JSON inputs and final paper PDFs belong in Git.
# Raster previews and old diagnostic renders are reproducible local outputs.
/figures/pic/**
!/figures/pic/pdf/
!/figures/pic/pdf/*.pdf

